# Dependencies and build output
node_modules/
dist/

# Third-party engines installed locally — gigabytes, and downloadable.
vendor/

# Speech and test models — hundreds of megabytes, and downloadable.
# See README for the commands that fetch them.
# Ignore the contents, not the directory: git cannot re-include a file whose
# parent directory is excluded, so "models/" plus a negation silently loses
# .gitkeep and the folder is missing from a fresh clone.
models/*
!models/.gitkeep

# Generated at build time from scripts/make-icon.js
assets/icon.png
assets/icon.icns
assets/icon.iconset/

# Wikipedia archives, wherever they land
*.zim

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors
.vscode/
.idea/
*.swp

# Logs and local scratch
*.log
npm-debug.log*
